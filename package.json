{
  "name": "mimicc-ai",
  "version": "0.1.0",
  "description": "TypeScript scaffold for agent development",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "chat": "bun src/main.ts",
    "start": "bun dist/main.js",
    "clean": "bun -e 'import { rm } from \"node:fs/promises\"; await rm(\"dist\", { recursive: true, force: true })'",
    "build": "bun run clean && bun build src/main.ts --target=bun --outdir=dist --sourcemap=linked",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage && bun scripts/coverage-gate.ts",
    "probes:smoke": "bun scripts/probe-smoke.ts",
    "bench:fingerprint": "bun scripts/bench-fingerprint.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test",
    "install:global": "bash scripts/install.sh install",
    "update:global": "bash scripts/install.sh update"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "typescript": "^5",
    "typescript-eslint": "^8.66.0"
  },
  "dependencies": {
    "@langchain/core": "^1.2.5",
    "@langchain/langgraph": "^1.4.9",
    "@langchain/openai": "^1.5.6",
    "langchain": "^1.5.5",
    "zod": "^4.4.3"
  }
}
