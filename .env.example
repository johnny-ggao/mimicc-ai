# Copy to .env and fill in. Bun loads .env automatically — no flag, no dotenv.
NODE_ENV=development
LOG_LEVEL=info

# Required. Any OpenAI-compatible endpoint; the defaults below target DeepSeek.
LLM_API_KEY=

# Optional — shown with their defaults.
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
