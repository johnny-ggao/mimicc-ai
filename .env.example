# Copy to .env and fill in. Bun loads .env automatically — no flag, no dotenv.
NODE_ENV=development
LOG_LEVEL=info

# Which provider to run on. "deepseek" (default), "moonshot-cn" or "zhipu-cn".
# LLM_PROVIDER=deepseek

# API key for the selected provider.
#   DeepSeek   → LLM_DEEPSEEK_API_KEY  (LLM_API_KEY still works as its legacy name)
#   Moonshot   → LLM_MOONSHOT_CN_API_KEY
#   智谱 GLM   → LLM_ZHIPU_CN_API_KEY
LLM_DEEPSEEK_API_KEY=

# Optional. Shown with their defaults.
# LLM_MODEL=deepseek-v4-flash
# LLM_BASE_URL=https://api.deepseek.com
#
# Moonshot (China region): set LLM_PROVIDER=moonshot-cn and LLM_MOONSHOT_CN_API_KEY.
# Models: kimi-k3 (default) / kimi-k2.7-code / kimi-k2.6. The base URL
# (https://api.moonshot.cn/v1) comes from the registry — do not set it.
#
# 智谱 GLM (China region): set LLM_PROVIDER=zhipu-cn and LLM_ZHIPU_CN_API_KEY.
# One model: glm-5.3-flash (default). The base URL
# (https://open.bigmodel.cn/api/paas/v4) comes from the registry — do not set it.
# The key must be an open.bigmodel.cn one; an international z.ai key 401s here.
