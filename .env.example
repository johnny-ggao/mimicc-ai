# Copy to .env and fill in. Bun loads .env automatically — no flag, no dotenv.
NODE_ENV=development
LOG_LEVEL=info

# Which provider to run on. "deepseek" (default) or "moonshot-cn".
# LLM_PROVIDER=deepseek

# API key for the selected provider.
#   DeepSeek   → LLM_DEEPSEEK_API_KEY  (LLM_API_KEY still works as its legacy name)
#   Moonshot   → LLM_MOONSHOT_CN_API_KEY
LLM_DEEPSEEK_API_KEY=

# Optional. Shown with their defaults.
# LLM_MODEL=deepseek-v4-flash
# LLM_BASE_URL=https://api.deepseek.com
#
# Moonshot (China region): set LLM_PROVIDER=moonshot-cn and LLM_MOONSHOT_CN_API_KEY.
# Models: kimi-k3 (default) / kimi-k2.7-code / kimi-k2.6. The base URL
# (https://api.moonshot.cn/v1) comes from the registry — do not set it.
